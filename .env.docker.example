# Copy to .env (next to docker-compose.yml) and change every secret.

# Postgres
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=inventory

# Backend security — REQUIRED, no safe defaults in production
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-characters
ALLOWED_ORIGINS=http://localhost:8080
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-strong-admin-password

# Optional — enables real Claude vision & task planning
ANTHROPIC_API_KEY=

# Storage: 'local' (Docker volume) or 's3'
STORAGE_BACKEND=local
# For S3, also set in docker-compose backend env: S3_BUCKET, S3_REGION, S3_ENDPOINT_URL

# Where the web app is exposed
WEB_PORT=8080
