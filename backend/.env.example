# Copy to .env and fill in. All values have safe dev defaults if omitted.

# Secret used to sign JWT session tokens. Change in production.
SECRET_KEY=dev-secret-change-me

# SQLAlchemy database URL. Defaults to a local SQLite file.
# For production Postgres:  postgresql+psycopg://user:pass@host:5432/inventory
DATABASE_URL=sqlite:///./inventory.db

# Where uploaded photos are stored on disk (dev). Prod = S3-compatible.
UPLOAD_DIR=./uploads

# Anthropic API key enables REAL Claude vision detection.
# Leave blank to run the built-in MOCK detector so the app still works end-to-end.
ANTHROPIC_API_KEY=

# Vision model used for photo -> tool detection.
VISION_MODEL=claude-opus-4-8

# Seeded admin account (created on first startup).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234
