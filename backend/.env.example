# Copy to .env and fill in. Dev defaults work as-is; production is validated
# at startup (see app/config.py validate_for_production).

# --- Runtime ---
# development | production  (production enforces secure settings below)
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Security ---
# REQUIRED in production: strong, random, >= 32 chars.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me
# "*" in dev; an explicit comma-separated list in production.
ALLOWED_ORIGINS=*

# --- Database ---
# SQLite for local dev; Postgres for production.
DATABASE_URL=sqlite:///./inventory.db
# postgresql+psycopg://user:pass@host:5432/inventory
# Create tables on boot (dev). In production use Alembic migrations and set false.
AUTO_CREATE_TABLES=true

# --- Storage ---
STORAGE_BACKEND=local          # local | s3
UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=

# --- AI (optional; mock fallback if blank) ---
ANTHROPIC_API_KEY=
VISION_MODEL=claude-opus-4-8

# --- Seeded admin (change in production) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234
