# Copy to .env and adjust for your environment.
DATABASE_URL=postgresql+psycopg2://bondly:bondly@localhost:5432/bondly
SECRET_KEY=change-me-to-a-long-random-string
ENVIRONMENT=development
DEBUG=true

# ---- AI (optional) ----
# When set, note categorization + message drafts use the Claude API.
# Leave blank to use the built-in heuristics.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ---- Social login (optional; leave blank to disable a provider) ----
# Google: the "Web application" OAuth client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=
# Apple: your Services ID (web) and/or app bundle ID, comma-separated.
APPLE_CLIENT_IDS=
