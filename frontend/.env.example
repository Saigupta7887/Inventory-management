# Base URL for the Bondly API. In dev, requests to /api are proxied to the
# backend by Vite (see vite.config.js), so this can stay empty.
VITE_API_BASE=

# ---- Social login (optional; leave blank to hide the button) ----
# Google "Web application" OAuth client ID (same value the backend uses).
VITE_GOOGLE_CLIENT_ID=
# Apple Services ID configured for Sign in with Apple on the web.
VITE_APPLE_CLIENT_ID=
